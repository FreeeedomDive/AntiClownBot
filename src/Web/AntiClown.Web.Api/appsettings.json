{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AntiClownDataApi": {
    "ServiceUrl": ""
  },
  "AntiClownApi": {
    "ServiceUrl": ""
  },
  "AntiClownEntertainmentApi": {
    "ServiceUrl": ""
  },
  "AntiClownDiscordApi": {
    "ServiceUrl": ""
  },
  "F1FastApi": {
    "ServiceUrl": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "",
          "apiKey": ""
        }
      }
    ],
    "Properties": {
      "Application": "AntiClown.Web.Api"
    }
  }
}
